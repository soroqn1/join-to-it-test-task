{
  "info": {
    "name": "Event Management API",
    "_postman_id": "events-api-v1",
    "description": "Postman Collection for Event Management REST API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000/api/v1"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"password123\",\n  \"password_confirm\": \"password123\",\n  \"first_name\": \"John\",\n  \"last_name\": \"Doe\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register",
                ""
              ]
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.access) {",
                  "    pm.collectionVariables.set('token', jsonData.access);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login",
                ""
              ]
            }
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"<your_refresh_token>\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/refresh/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "refresh",
                ""
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/me/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "me",
                ""
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Events",
      "item": [
        {
          "name": "List Events",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/events/?search=Django",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events",
                ""
              ],
              "query": [
                {
                  "key": "search",
                  "value": "Django"
                },
                {
                  "key": "location",
                  "value": "Kyiv",
                  "disabled": true
                },
                {
                  "key": "organizer",
                  "value": "1",
                  "disabled": true
                }
              ]
            }
          }
        },
        {
          "name": "Create Event",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Django & AI Conference 2026\",\n  \"description\": \"Building modern REST APIs with Django, Celery and Redis.\",\n  \"date\": \"2026-10-15T10:00:00Z\",\n  \"location\": \"Kyiv, Ukraine\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/events/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events",
                ""
              ]
            }
          }
        },
        {
          "name": "Event Detail",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/events/1/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events",
                "1",
                ""
              ]
            }
          }
        },
        {
          "name": "Update Event",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated Event Title\",\n  \"description\": \"Updated Event Description\",\n  \"date\": \"2026-10-20T10:00:00Z\",\n  \"location\": \"Lviv, Ukraine\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/events/1/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events",
                "1",
                ""
              ]
            }
          }
        },
        {
          "name": "Delete Event",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/events/1/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events",
                "1",
                ""
              ]
            }
          }
        },
        {
          "name": "Join Event",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/events/1/register/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events",
                "1",
                "register",
                ""
              ]
            }
          }
        },
        {
          "name": "Leave Event",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/events/1/register/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events",
                "1",
                "register",
                ""
              ]
            }
          }
        }
      ]
    }
  ]
}
